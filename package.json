{
  "name": "@zihaolam/bun-sqlite-migrations",
  "version": "1.0.3",
  "license": "MIT",
  "author": "Lam Zi Hao <lamzihao98@gmail.com>",
  "repository": {
    "type": "git",
    "url": "github:zihaolam/bun-sqlite-migrations"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check-format": "prettier --ignore-path .gitignore '**/*.ts' --check",
    "check-types": "tsc --version && tsc --noEmit --skipLibCheck",
    "build:js": "bun build ./src/index.ts --target=node --minify --sourcemap --outdir=./dist",
    "build:types": "tsc --project tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "package": "bun run build",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "bun-types": "latest",
    "prettier": "^3.0.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
